# Copie este arquivo para ".env" e preencha. Nunca publique o .env.
# Supabase (Project Settings > API): sem estas duas linhas, o app guarda tudo só no aparelho.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Site com a Política de privacidade e os Termos (pasta docs/site publicada)
EXPO_PUBLIC_SITE_URL=https://destiapp.com.br
EXPO_PUBLIC_SUPPORT_EMAIL=contato@destiapp.com.br

# Aviso de erros (opcional): sentry.io > Projeto React Native > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Mapa no Android: Google Cloud > Maps SDK for Android > chave de API (restrinja ao pacote app.desti)
GOOGLE_MAPS_ANDROID_KEY=

# Afiliados (opcional): Booking.com (aid) e GetYourGuide (partner_id)
EXPO_PUBLIC_BOOKING_AID=
EXPO_PUBLIC_GYG_PARTNER_ID=
